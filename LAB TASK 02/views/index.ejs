<%- include('partials/header') %>



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Tag - Men's Fashion</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    <div class="nav-overlay"></div>

   
    <div class="top-bar">
        <div class="messages">
            <span>Customer Support: Mon–Sat | 9 AM – 9 PM</span>
            <span>Free Shipping on Orders Above 5000</span>
            <span>10% OFF for New Customers</span>
            <span>Cash on Delivery Available</span>
        </div>
    </div>

    

   
    <section class="hero" style="background-image: url('/assest/image.png');">
        <a href="shop.html" class="hero-link"></a>
        <div class="hero-content"></div>
    </section>

   
    <section class="hero" style="background-image: url('/assest/Polo\ Shirt.jpg');">
        <a href="shop.html" class="hero-link"></a>
    </section>

   
    <section class="hero" style="background-image: url('/assest/T-shirt.webp');">
        <a href="shop.html" class="hero-link"></a>
    </section>

   
    <section class="hero" style="background-image: url('/assest/tehwar collection.jpg');">
        <a href="shop.html" class="hero-link"></a>
    </section>

   
    <section class="products">
        <div class="container-full">
            <h2>THE HERITAGE POLOS</h2>
            <div class="product-grid">

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\hertiage polo pict 1.webp" alt="Off White Signature Polo">
                    <h3>Off White Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\hertiage polo 2.jpg" alt="Navy Signature Polo">
                    <h3>Navy Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\black signature polo.webp" alt="Black Signature Polo">
                    <h3>Black Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\olive signature polo.webp" alt="Olive Signature Polo">
                    <h3>Olive Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\beige signature polo.webp" alt="Beige Signature Polo">
                    <h3>Beige Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\pink signature polo.jpg" alt="Pink Signature Polo">
                    <h3>Pink Signature Polo</h3>
                    <p class="price">Rs.7,450</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\brown signature polo.webp" alt="Brown Signature Polo">
                    <h3>Brown Signature Polo</h3>
                    <p class="price">Rs.7,250</p>
                </div>

                <div class="product-card">
                    <span class="badge">New</span>
                    <img src="\assest\rust signature polo.jpg" alt="Rust Signature Polo">
                    <h3>Rust Signature Polo</h3>
                    <p class="price">Rs.7,250</p>
                </div>

            </div>
            <button class="btn-show-more">SHOW MORE</button>
        </div>
    </section>

   
    <section class="shop-style">
        <div class="shop-style-header">
            <h2>SHOP BY STYLE</h2>
            <p>From crisp formals to casuals find the look that fits every occasion</p>
        </div>
        <div class="style-grid">
            <div class="style-card">
                <img src="\assest\formals.webp" alt="Formals">
            </div>
            <div class="style-card">
                <img src="\assest\causals.webp" alt="Casuals">
            </div>
            <div class="style-card">
                <img src="\assest\tehwar.webp" alt="Tehwar">
            </div>
            <div class="style-card">
                <img src="\assest\accessoires.webp" alt="Accessories">
            </div>
        </div>
    </section>

   
    <section class="reviews">
        <div class="container-full">
            <h2>What Our Customers Say</h2>
            <div class="stars">⭐⭐⭐⭐⭐</div>
            <p class="subtitle">Real experiences, honest feedback, and genuine trust in Royal Tag.</p>

            <div class="review-grid">
                <div class="review-card">
                    <div class="stars">⭐⭐⭐⭐⭐</div>
                    <h3>Nice</h3>
                    <p>Nice</p>
                    <p class="reviewer">Noman Yousaf</p>
                </div>
                <div class="review-card">
                    <div class="stars">⭐⭐⭐⭐⭐</div>
                    <h3>Amazing</h3>
                    <p>Amazing</p>
                    <p class="reviewer">Syed M Ali Akbar</p>
                </div>
                <div class="review-card">
                    <div class="stars">⭐⭐⭐⭐⭐</div>
                    <h3>Great</h3>
                    <p>Great quality</p>
                    <p class="reviewer">Usama</p>
                </div>
                <div class="review-card">
                    <div class="stars">⭐⭐⭐⭐⭐</div>
                    <h3>Good Quality</h3>
                    <p>Good Quality product</p>
                    <p class="reviewer">Talha Paracha</p>
                </div>
            </div>
        </div>
    </section>

   
   
    <script src="/javascripts/script.js"></script>

</body>
</html>

 <%- include('partials/footer') %> 