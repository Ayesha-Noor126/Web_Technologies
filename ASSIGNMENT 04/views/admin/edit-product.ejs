<%- include('partials/admin-header') %>

<div class="admin-page">
  <%- include('partials/admin-sidebar', { activePage: 'products' }) %>

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h1>Edit Product</h1>
        <p>Update the product details below</p>
      </div>
      <a href="/admin/products" class="admin-btn-sm">
        <i class="fa fa-arrow-left"></i> Back
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="admin-alert error"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="admin-alert success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
    <% } %>

    <div class="admin-form-box">
      <form action="/admin/products/edit/<%= product._id %>" method="POST" class="admin-form" id="productForm">

        <!-- Carries final image URLs (existing or newly uploaded) -->
        <input type="hidden" name="imageUrls" id="cloudinaryUrls"
          value="<%= product.images ? product.images.join(',') : '' %>">

        <div class="form-row">
          <div class="form-group">
            <label>Product Name *</label>
            <input type="text" name="name" value="<%= product.name %>" required>
          </div>
          <div class="form-group">
            <label>Price (Rs.) *</label>
            <input type="number" name="price" value="<%= product.price %>" required min="0">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Category *</label>
            <select name="category" required>
              <% [
                ['polo-shirts','Polo Shirts'],['suits','Suits & Coats'],
                ['casual-shirts','Casual Shirts'],['formal-shirts','Formal Shirts'],
                ['t-shirts','T-Shirts'],['tehwar','Tehwar'],
                ['accessories','Accessories'],['trousers','Trousers'],
                ['online-only','Online Only'],['sale','Sale']
              ].forEach(([val, label]) => { %>
                <option value="<%= val %>" <%= product.category === val ? 'selected' : '' %>><%= label %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label>Badge <small>(optional)</small></label>
            <select name="badge">
              <option value=""        <%= !product.badge              ? 'selected':'' %>>No Badge</option>
              <option value="New"     <%= product.badge==='New'     ? 'selected':'' %>>New</option>
              <option value="Sale"    <%= product.badge==='Sale'    ? 'selected':'' %>>Sale</option>
              <option value="Hot"     <%= product.badge==='Hot'     ? 'selected':'' %>>Hot</option>
              <option value="Limited" <%= product.badge==='Limited' ? 'selected':'' %>>Limited</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Stock *</label>
            <input type="number" name="stock" value="<%= product.stock %>" required min="0">
          </div>
          <div class="form-group">
            <label>Sizes</label>
            <div class="size-checkboxes">
              <% ['S','M','L','XL','XXL'].forEach(size => { %>
                <label class="size-check-label">
                  <input type="checkbox" name="sizes" value="<%= size %>"
                    <%= product.sizes && product.sizes.includes(size) ? 'checked' : '' %>>
                  <%= size %>
                </label>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="4"><%= product.description %></textarea>
        </div>

        <div class="form-group">
          <label>Product Images <small>(select new to replace current)</small></label>

          <% if (product.images && product.images.length > 0) { %>
            <p style="font-size:12px;color:#6b7280;margin-bottom:8px;font-weight:400;text-transform:none;letter-spacing:0;">
              Current images (kept unless you upload new ones):
            </p>
            <div class="image-preview-row" style="margin-bottom:14px;">
              <% product.images.forEach(img => { %>
                <img src="<%= img %>" alt="product image">
              <% }) %>
            </div>
          <% } %>

          <label class="file-upload-label" id="uploadLabel">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span id="uploadLabelText">Click to select new images (optional)</span>
            <input type="file" id="imageFiles" multiple accept="image/*" onchange="handleImageSelect(this)">
          </label>
          <small>Selecting new images will replace the current ones on Cloudinary.</small>

          <div id="imagePreview" class="image-preview-row" style="margin-top:12px;"></div>

          <div id="uploadProgress" style="display:none;margin-top:10px;">
            <div style="background:#e5e7eb;border-radius:6px;height:6px;overflow:hidden;">
              <div id="progressBar" style="background:#1f3d34;height:100%;width:0%;transition:width 0.3s;"></div>
            </div>
            <p id="progressText" style="font-size:12px;color:#6b7280;margin-top:6px;"></p>
          </div>
        </div>

        <button type="submit" class="admin-submit-btn" id="submitBtn">
          <i class="fa fa-save"></i> SAVE CHANGES
        </button>
      </form>
    </div>
  </main>
</div>

<script>
const CLOUDINARY_CLOUD_NAME    = 'YOUR_CLOUD_NAME';
const CLOUDINARY_UPLOAD_PRESET = 'YOUR_PRESET';

let selectedFiles = [];

function handleImageSelect(input) {
  selectedFiles = Array.from(input.files).slice(0, 5);
  const preview = document.getElementById('imagePreview');
  const label   = document.getElementById('uploadLabelText');
  preview.innerHTML = '';
  label.textContent = selectedFiles.length
    ? `${selectedFiles.length} new image(s) selected — will replace current on save`
    : 'Click to select new images (optional)';

  selectedFiles.forEach(file => {
    const reader = new FileReader();
    reader.onload = e => {
      const img = document.createElement('img');
      img.src = e.target.result;
      img.style.cssText = 'width:78px;height:94px;object-fit:cover;border-radius:6px;border:2px solid #1f3d34;';
      preview.appendChild(img);
    };
    reader.readAsDataURL(file);
  });
}

async function uploadToCloudinary(file) {
  const fd = new FormData();
  fd.append('file', file);
  fd.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);
  fd.append('folder', 'royal_tag/products');
  const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/image/upload`, { method:'POST', body:fd });
  if (!res.ok) throw new Error('Upload failed');
  return (await res.json()).secure_url;
}

document.getElementById('productForm').addEventListener('submit', async function(e) {
  if (!selectedFiles.length) return; // keep existing images, submit normally
  e.preventDefault();

  const btn  = document.getElementById('submitBtn');
  const prog = document.getElementById('uploadProgress');
  const bar  = document.getElementById('progressBar');
  const text = document.getElementById('progressText');

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';
  prog.style.display = 'block';

  try {
    const urls = [];
    for (let i = 0; i < selectedFiles.length; i++) {
      text.textContent = `Uploading ${i+1}/${selectedFiles.length}...`;
      bar.style.width  = `${Math.round((i/selectedFiles.length)*100)}%`;
      urls.push(await uploadToCloudinary(selectedFiles[i]));
      bar.style.width  = `${Math.round(((i+1)/selectedFiles.length)*100)}%`;
    }
    document.getElementById('cloudinaryUrls').value = urls.join(',');
    text.textContent = 'Done! Saving...';
    this.submit();
  } catch(err) {
    text.textContent = 'Upload failed: ' + err.message;
    text.style.color = '#dc2626';
    btn.disabled = false;
    btn.innerHTML = '<i class="fa fa-save"></i> SAVE CHANGES';
  }
});
</script>

<%- include('partials/admin-footer') %>
