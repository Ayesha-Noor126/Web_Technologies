<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>






<%- include('partials/header') %>

<div class="checkout-page">
  <div class="checkout-container">
    <h1 class="cart-title">CHECKOUT</h1>

    <div class="checkout-layout">

      <!-- LEFT: DELIVERY FORM -->
      <div class="checkout-form-side">
        <h2 class="checkout-section-title">DELIVERY INFORMATION</h2>

        <form action="/checkout/place-order" method="POST" class="auth-form">

          <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="name" value="<%= user.name %>" required />
          </div>

          <div class="form-group">
            <label>Phone Number</label>
            <input type="text" name="phone" placeholder="03XX-XXXXXXX" required />
          </div>

          <div class="form-group">
            <label>Street Address</label>
            <input type="text" name="address" placeholder="House no, Street, Area" required />
          </div>

          <div class="form-group">
            <label>City</label>
            <input type="text" name="city" placeholder="Lahore" required />
          </div>

          <div class="form-group">
            <label>Payment Method</label>
            <select name="payment" style="width:100%; padding: 11px 14px; border: 1px solid #ddd; font-size:14px; background:#fafafa;">
              <option value="cod">Cash on Delivery</option>
            </select>
          </div>

          <button type="submit" class="btn-auth" style="margin-top: 20px;">
            PLACE ORDER
          </button>

        </form>
      </div>

      <!-- RIGHT: ORDER SUMMARY -->
      <div class="cart-summary">
        <h2>YOUR ORDER</h2>

        <% cart.forEach(item => { %>
          <div class="checkout-item">
            <img src="<%= item.product.images[0] %>" alt="<%= item.product.name %>">
            <div>
              <p class="checkout-item-name"><%= item.product.name %></p>
              <p class="checkout-item-qty">Qty: <%= item.quantity %></p>
              <p class="checkout-item-price">Rs.<%= (item.product.price * item.quantity).toLocaleString() %></p>
            </div>
          </div>
        <% }) %>

        <div class="summary-divider"></div>

        <div class="summary-row">
          <span>Subtotal</span>
          <span>Rs.<%= total.toLocaleString() %></span>
        </div>
        <div class="summary-row">
          <span>Shipping</span>
          <span><%= total >= 5000 ? 'FREE' : 'Rs.200' %></span>
        </div>
        <div class="summary-divider"></div>
        <div class="summary-row total-row">
          <span>Total</span>
          <span>Rs.<%= (total >= 5000 ? total : total + 200).toLocaleString() %></span>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
</body> 
</html>